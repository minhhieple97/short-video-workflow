generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum LessonOrigin {
  AI
  MANUAL
}

enum LessonStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

enum PlatformPreviewMode {
  TIKTOK
  YOUTUBE_SHORTS
  FACEBOOK_REELS
}

enum VideoProfile {
  SHORT_VERTICAL
}

enum MediaAssetKind {
  VOICEOVER
  MUSIC
  RENDER
}

enum RenderQualityPreset {
  DRAFT
  FINAL
}

enum JobStatus {
  QUEUED
  WAITING_FOR_CLI
  RUNNING
  COMPLETED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
}

enum JobCreatedBy {
  LOCAL_USER
}

model Book {
  id              String    @id @default(cuid())
  title           String
  author          String?
  description     String?
  language        String    @default("vi")
  slug            String?   @unique
  sourceFilePath  String
  sourceFileName  String
  sourceHash      String
  // "md" | "txt" | "pdf" — validated by features/books/domain (String keeps room for new formats without a migration).
  sourceFormat    String
  sourceSizeBytes Int
  // "ACTIVE" | "DELETED" (soft delete, alongside deletedAt).
  status          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  chapters          Chapter[]
  lessons           Lesson[]
  videos            Video[]
  extractions       BookExtraction[]
  productionBatches ProductionBatch[]
  notebooks         NotebookBinding[]

  @@index([status])
  @@index([createdAt])
  @@index([sourceHash])
}

model Chapter {
  id                    String    @id @default(cuid())
  bookId                String
  book                  Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order                 Int
  title                 String
  // Prefer file storage (data/books/{bookId}/chapters/{chapterId}.md); `content` is the inline fallback.
  contentPath           String?
  content               String?
  sourceStartOffset     Int?
  sourceEndOffset       Int?
  contentHash           String
  // CHAPTER_ANALYSIS_STATUSES in features/chapters/domain/analysis-status.ts.
  analysisStatus        String
  analyzedAt            DateTime?
  analysisPromptVersion String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  lessonSources LessonSource[]

  @@unique([bookId, order])
  @@index([bookId])
}

model Lesson {
  id                    String       @id @default(cuid())
  bookId                String
  book                  Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title                 String
  summary               String
  principle             String
  realLifeScenario      String
  commonMistake         String
  betterApproach        String
  actionableStep        String
  origin                LessonOrigin
  status                LessonStatus @default(DRAFT)
  contentHash           String?
  analysisPromptVersion String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  sources         LessonSource[]
  videoLessons    VideoLesson[]
  productionItems ProductionItem[]

  @@index([bookId])
  @@index([status])
}

model LessonSource {
  id            String  @id @default(cuid())
  lessonId      String
  lesson        Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  chapterId     String
  chapter       Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sourceExcerpt String?
  sourceLocator String?
  confidence    Float?

  // SQLite treats NULL locators as distinct, so uniqueness applies only when a locator is present.
  @@unique([lessonId, chapterId, sourceLocator])
  @@index([lessonId])
  @@index([chapterId])
}

model Video {
  id                     String               @id @default(cuid())
  bookId                 String
  book                   Book                 @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title                  String
  description            String?
  // VIDEO_STATUSES in features/videos/domain/video-status.ts (DRAFT | NEEDS_REVIEW | APPROVED).
  status                 String               @default("DRAFT")
  aspectRatio            String               @default("9:16")
  fps                    Int                  @default(30)
  width                  Int                  @default(1080)
  height                 Int                  @default(1920)
  videoProfile           VideoProfile         @default(SHORT_VERTICAL)
  // The length the AI planned the script for (one of DURATION_PRESETS_SEC, enforced by Zod); the range's maximum until a
  // script proposes one.
  targetDurationSec      Int                  @default(60)
  // The lengths the user allows; the AI picks targetDurationSec inside them and the final render may not exceed the max.
  minDurationSec         Int                  @default(30)
  maxDurationSec         Int                  @default(300)
  // Why the AI chose targetDurationSec, in Vietnamese; null until a script or a production draft proposed a length.
  durationReason         String?
  scriptVersion          Int                  @default(1)
  approvedScriptVersion  Int?
  // The scriptVersion at which the automated checks last passed. It is not an approval by a person: it only lets a FINAL
  // render proceed, and any later change bumps scriptVersion so it stops matching.
  autoReadyScriptVersion Int?
  platformPreviewMode    PlatformPreviewMode?
  // 2–3 AI hook proposals ({ variant, narration, onScreenText, visualVariant }[]); the chosen one becomes the HOOK scene.
  hookOptionsJson        Json?
  // Loose pointer to RenderRecord.id (no relation) to avoid a circular reference.
  latestRenderId         String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  videoLessons   VideoLesson[]
  scenes         VideoScene[]
  renders        RenderRecord[]
  mediaAssets    MediaAsset[]
  productionItem ProductionItem?

  @@index([bookId])
  @@index([status])
  @@index([createdAt])
}

model VideoLesson {
  id                 String   @id @default(cuid())
  videoId            String
  video              Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  lessonId           String
  lesson             Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  position           Int
  lessonSnapshotJson Json
  createdAt          DateTime @default(now())

  @@unique([videoId, lessonId])
  @@unique([videoId, position])
  @@index([lessonId])
}

model VideoScene {
  id               String   @id @default(cuid())
  videoId          String
  video            Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  order            Int
  // SCENE_TYPES / VISUAL_VARIANTS / HOOK_VARIANTS in features/videos/domain/scene-types.ts.
  type             String
  title            String?
  narration        String
  onScreenText     String
  visualVariant    String
  durationFrames   Int?
  estimatedSeconds Float?
  // Only meaningful when type = HOOK.
  hookVariant      String?
  // Loose pointer to MediaAsset.id (no relation), mirroring Video.latestRenderId.
  audioAssetId     String?
  contentHash      String
  version          Int      @default(1)
  // Hidden scenes stay in the script but are skipped in preview and render.
  hidden           Boolean  @default(false)
  // JSON {setting, action} of the scene's animated cartoon; null means the default picture for its type.
  illustrationJson String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  mediaAssets MediaAsset[]

  @@unique([videoId, order])
  @@index([videoId])
}

model MediaAsset {
  id                     String         @id @default(cuid())
  videoId                String?
  video                  Video?         @relation(fields: [videoId], references: [id], onDelete: Cascade)
  sceneId                String?
  scene                  VideoScene?    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  kind                   MediaAssetKind
  // Relative to DATA_DIR.
  path                   String
  mimeType               String
  durationMs             Int?
  fileSizeBytes          Int
  contentHash            String?
  provider               String?
  generationSettingsJson Json?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([videoId])
  @@index([sceneId])
  @@index([kind])
}

model RenderRecord {
  id              String              @id @default(cuid())
  videoId         String
  video           Video               @relation(fields: [videoId], references: [id], onDelete: Cascade)
  // Loose pointer to JobRecord.id (no relation).
  jobRecordId     String?
  scriptVersion   Int
  // Relative to DATA_DIR.
  outputPath      String
  // QUEUED | RENDERING | COMPLETED | FAILED | CANCELLED. "Outdated" is derived (scriptVersion < Video.scriptVersion), not stored.
  status          String
  durationMs      Int?
  qualityPreset   RenderQualityPreset
  width           Int
  height          Int
  fps             Int
  createdAt       DateTime            @default(now())
  completedAt     DateTime?
  errorMessage    String?
  // What this render was made from, captured when it was requested and never changed afterwards (a RenderSnapshot).
  snapshotJson    Json?
  snapshotHash    String?
  // Set in the same update that completes a FINAL render, so "this MP4 should be archived" survives any crash or queue outage
  // after the render; the archive step reads it and never needs the render to be run again.
  archiveIntentAt DateTime?
  archives        RenderArchive[]

  @@index([videoId])
  @@index([status])
  @@index([createdAt])
}

// One archive of one render to one destination. Kept apart from the render: an archive failure never changes the render
// or its MP4, and archiving again never needs the render to be made again.
model RenderArchive {
  id             String              @id @default(cuid())
  renderId       String
  render         RenderRecord        @relation(fields: [renderId], references: [id], onDelete: Cascade)
  // The VideoArchiveProvider id, e.g. "google-drive".
  provider       String
  // Which account and root folder the archive writes to: connecting another account makes a new archive.
  destinationKey String
  // PENDING | RUNNING | WAITING | COMPLETED | FAILED.
  status         String              @default("PENDING")
  // The render's folder on the remote side, allocated before any file is uploaded and never changed afterwards.
  remoteFolderId String?
  // Temporary failures in a row (quota, outage); bounded so an archive that never gets through ends with its reason.
  retries        Int                 @default(0)
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  completedAt    DateTime?
  files          RenderArchiveFile[]

  @@unique([renderId, provider, destinationKey])
  @@index([status])
}

// A folder of the archive tree in one destination, identified by its path below the app's root folder ("" is the root).
// Its remote ID is stored before the folder is created, so a create that lost its answer is repeated with the same ID
// (Drive answers 409 instead of making a second folder). Folders are never looked up by searching the user's Drive.
model ArchiveFolder {
  id             String    @id @default(cuid())
  provider       String
  destinationKey String
  path           String
  remoteId       String
  createdAt      DateTime  @default(now())
  // Set once the remote side confirmed the folder exists.
  confirmedAt    DateTime?

  @@unique([provider, destinationKey, path])
}

model RenderArchiveFile {
  id              String        @id @default(cuid())
  archiveId       String
  archive         RenderArchive @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  // VIDEO | SCRIPT | MANIFEST.
  kind            String
  remoteName      String
  // Allocated before the upload starts and never changed, so a replay after a lost response targets the same object.
  remoteFileId    String?
  // PENDING | UPLOADING | UPLOADED | VERIFIED.
  status          String        @default("PENDING")
  // Relative to DATA_DIR, with the size and checksum the file had when it was handed to the archive.
  localPath       String?
  bytes           Int?
  sha256          String?
  // Only what resuming an interrupted upload needs. The token can grant upload access, so it never leaves the server.
  checkpointToken String?
  checkpointBytes Int           @default(0)
  verifiedAt      DateTime?

  @@unique([archiveId, kind])
}

model JobRecord {
  id                 String       @id @default(cuid())
  bullmqJobId        String       @unique
  jobType            String
  // SYSTEM (diagnostics) | CHAPTER | VIDEO | SCENE | RENDER | PRODUCTION_ITEM | ARCHIVE | EXTRACTION.
  entityType         String
  entityId           String
  status             JobStatus    @default(QUEUED)
  progress           Int          @default(0)
  attempts           Int          @default(0)
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime     @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  updatedAt          DateTime     @updatedAt
  requestFingerprint String?
  createdBy          JobCreatedBy @default(LOCAL_USER)
  dispatch           JobDispatch?

  @@index([status])
  @@index([createdAt])
  @@index([entityType, entityId])
}

// Outbox row created in the same transaction as its JobRecord. dispatchedAt stays null until the BullMQ job exists,
// so a crash between the SQLite write and the Redis add cannot lose the job; availableAt holds delayed jobs back.
model JobDispatch {
  id           String    @id @default(cuid())
  jobRecordId  String    @unique
  jobRecord    JobRecord @relation(fields: [jobRecordId], references: [id], onDelete: Cascade)
  // IDs and small metadata only, without jobRecordId (added when the job is dispatched).
  payloadJson  String
  availableAt  DateTime  @default(now())
  attempts     Int       @default(0)
  lastError    String?
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?

  @@index([dispatchedAt, availableAt])
}

model AiRun {
  id            String    @id @default(cuid())
  // Loose pointer to JobRecord.id (no relation).
  jobRecordId   String?
  // "mock" | "cli-task" | "cli-auto" | "notebooklm"; never store secrets or session tokens in this table.
  mode          String
  promptVersion String
  inputHash     String
  outputPath    String?
  status        String
  errorMessage  String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([jobRecordId])
  @@index([status])
}

// One pass that turns a PDF book into per-page text: the local text layer first, OCR only for pages without usable text.
// The PDF stays immutable; everything here is derived and can be rebuilt from it.
model BookExtraction {
  id                   String    @id @default(cuid())
  bookId               String
  book                 Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  // QUEUED | INSPECTING | EXTRACTING | OCR_PENDING | ASSEMBLING | DETECTING_CHAPTERS | NEEDS_CHAPTERS | COMPLETED | PARTIAL
  // | FAILED | CANCELLED
  status               String
  // SHA-256 of the PDF this run read, so the run is tied to exact bytes.
  sourceHash           String
  // Known once the PDF has been inspected.
  pageCount            Int?
  // OCR provider and pinned model chosen for this run; null while no page needs OCR.
  ocrProvider          String?
  ocrModel             String?
  // Money is kept in integer micro-USD so ceiling checks never suffer floating-point drift.
  costCeilingMicroUsd  Int?
  // Amount reserved for OCR that is submitted or whose outcome is unknown.
  reservedCostMicroUsd Int       @default(0)
  actualCostMicroUsd   Int       @default(0)
  // Relative path (under DATA_DIR) of the assembled canonical Markdown.
  canonicalPath        String?
  errorCode            String?
  errorMessage         String?
  // Temporary OCR provider failures in a row; reset by any progress, and bounded so a run cannot wait forever.
  transientFailures    Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  completedAt          DateTime?

  pages         ExtractionPage[]
  ocrOperations OcrOperation[]

  @@index([bookId])
  @@index([status])
}

// Result for one page of the source PDF. A blank page is a valid EXTRACTED result (method EMPTY), distinct from FAILED.
model ExtractionPage {
  id           String         @id @default(cuid())
  extractionId String
  extraction   BookExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  // 1-based page number in the source PDF; never an offset into normalized text.
  pageNumber   Int
  // PENDING | EXTRACTED | NEEDS_OCR | OCR_SUBMITTED | FAILED
  status       String
  // Set once the page is classified: TEXT | OCR | EMPTY.
  method       String?
  // Why the text layer was not usable, for pages that go to OCR.
  ocrReason    String?
  text         String?
  // OCR confidence 0..1 exactly as the provider reported it; null when none was reported (never invented).
  confidence   Float?
  errorCode    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([extractionId, pageNumber])
  @@index([extractionId, status])
}

// A batch handed to a remote OCR provider. The row exists before the submit call so an unknown outcome can be reconciled.
model OcrOperation {
  id                   String         @id @default(cuid())
  extractionId         String
  extraction           BookExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  provider             String
  model                String
  // Stable idempotency key the adapter uses to recognise a submission it already made.
  requestKey           String         @unique
  // PLANNED | SUBMITTING | SUBMITTED | COMPLETED | FAILED | CANCELLED | UNKNOWN_OUTCOME
  status               String
  // Opaque provider handle (OcrProvider operationRef); services never parse it.
  operationRef         String?
  // JSON [{chunkId, pageNumbers}]: which PDF pages each chunk holds, to rebuild the chunk files and map results back.
  chunkPlanJson        String?
  pageCount            Int
  reservedCostMicroUsd Int
  // Only set when the provider reports a real figure.
  actualCostMicroUsd   Int?
  errorCode            String?
  errorMessage         String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  submittedAt          DateTime?
  lastPolledAt         DateTime?
  completedAt          DateTime?
  // Output saved locally; provider-side cleanup may only happen after this is set.
  outputStoredAt       DateTime?
  cleanedAt            DateTime?

  @@index([extractionId])
  @@index([status])
}

// A request to produce videos from lessons the user selected in one book. One item is one lesson and one video.
model ProductionBatch {
  id                String    @id @default(cuid())
  bookId            String
  book              Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  // Supplied by the caller; a repeated request with the same key returns this batch instead of making another.
  idempotencyKey    String    @unique
  // Hash of what was asked for (book, lessons, duration range), to notice the same key being reused for different content.
  fingerprint       String
  // No longer read: the batch's range is min/maxDurationSec and each video gets its own proposed length. Written as the
  // maximum so the column stays filled without a destructive migration.
  targetDurationSec Int
  minDurationSec    Int       @default(30)
  maxDurationSec    Int       @default(300)
  // QUEUED | RUNNING | COMPLETED | PARTIAL | FAILED | CANCELLED (a read model derived from the items).
  status            String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?

  items ProductionItem[]

  @@index([bookId])
  @@index([status])
}

model ProductionItem {
  id                     String          @id @default(cuid())
  batchId                String
  batch                  ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  // Restrict: a lesson cannot be hard-deleted while a production still points at it.
  lessonId               String
  lesson                 Lesson          @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  position               Int
  // The video made for this item; set when the item is created, so a retry reuses it instead of creating another.
  videoId                String?         @unique
  video                  Video?          @relation(fields: [videoId], references: [id], onDelete: SetNull)
  // PENDING | RUNNING | WAITING | COMPLETED | FAILED | CANCELLED
  status                 String
  // The last step finished, so a restart skips what is done: NONE | DRAFTED | COMPILED | APPLIED | VOICED | READY | RENDERED
  checkpoint             String          @default("NONE")
  // Fingerprint of the scene plan whose scenes are currently on the video, so applying the same plan again changes nothing.
  appliedPlanFingerprint String?
  // The single AI correction a video gets: where it went (SCRIPT_STUDIO | SCENE_COMPILER) and what it was told. Null while unused.
  aiCorrectionTarget     String?
  aiCorrectionNote       String?
  // The two artifacts that travel between steps, kept apart (see server/scene-plan/handoff.ts): what the script studio wrote
  // and what the compiler made of it. Each is re-validated, fingerprint included, when it is read.
  draftArtifactJson      Json?
  scenePlanArtifactJson  Json?
  // Consecutive attempts that ended in a temporary failure (quota, outage); reset by any step that succeeds.
  transientRetries       Int             @default(0)
  // The FINAL render this item is waiting for or finished with; cleared when the item is retried after a failed render.
  renderId               String?
  // Lease so that only one worker advances an item at a time; an expired lease can be taken over.
  claimToken             String?
  claimExpiresAt         DateTime?
  errorCode              String?
  errorMessage           String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  completedAt            DateTime?

  @@unique([batchId, lessonId])
  @@unique([batchId, position])
  @@index([status])
}

// A Google sign-in that was started and not finished yet. Only a hash of the state is stored, the code verifier never
// leaves the server, and a row can be used once before it expires.
model OAuthAuthorization {
  id           String    @id @default(cuid())
  provider     String
  stateHash    String    @unique
  codeVerifier String
  redirectUri  String
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([expiresAt])
}

// Drive API use by this app only (not the whole Google project or account), per hour, so the archive stays within its
// daily request and upload limits. Hours older than a day are dropped.
model DriveUsageHour {
  id        String   @id @default(cuid())
  provider  String
  hourStart DateTime
  requests  Int      @default(0)
  bytesSent BigInt   @default(0)

  @@unique([provider, hourStart])
}

// What Google last reported about an account's storage, so the UI and the check before an upload never call Google.
// Storage capacity says nothing about API quotas, whatever the account's storage plan.
model DriveCapacity {
  destinationKey String   @id
  // Null when the account has unlimited storage.
  limitBytes     BigInt?
  usageBytes     BigInt
  fetchedAt      DateTime
}

// The NotebookLM notebook this app made for one book in one NotebookLM account (profile); every later step of that book
// reuses it. The remote ID is written once.
model NotebookBinding {
  id         String                  @id @default(cuid())
  bookId     String
  book       Book                    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  profile    String
  // PENDING | CREATING | UNKNOWN_OUTCOME | READY. UNKNOWN_OUTCOME: the create was sent but its answer was lost.
  status     String                  @default("PENDING")
  notebookId String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  sources    NotebookSourceBinding[]

  @@unique([bookId, profile])
}

// One part of the book's text, at one revision (its content hash), uploaded as a NotebookLM source. Changed text is a new
// row; the older revision is marked superseded but kept, with its remote ID, so what earlier lessons were drawn from
// stays traceable.
model NotebookSourceBinding {
  id                String          @id @default(cuid())
  notebookBindingId String
  notebook          NotebookBinding @relation(fields: [notebookBindingId], references: [id], onDelete: Cascade)
  // Which part of the book this is, e.g. "chapter:<chapterId>".
  sourceKey         String
  contentHash       String
  // The title sent to NotebookLM; it carries this row's ID so the source can be recognised after a lost answer.
  title             String
  // PENDING | SUBMITTING | UNKNOWN_OUTCOME | READY | FAILED.
  status            String          @default("PENDING")
  remoteSourceId    String?
  supersededAt      DateTime?
  createdAt         DateTime        @default(now())
  readyAt           DateTime?

  @@unique([notebookBindingId, sourceKey, contentHash])
  @@index([notebookBindingId, sourceKey])
}

// A script draft that passed validation, kept by what it was written from (provider and its draft prompt version, the
// lesson's content, the preset, the exact source revisions and the correction note). The same request is answered from
// here, so a retry after a crash or a later batch of the same lesson does not spend NotebookLM quota again.
model ScriptDraftCache {
  id           String   @id @default(cuid())
  cacheKey     String   @unique
  provider     String
  draftVersion String
  lessonId     String
  draftJson    String
  createdAt    DateTime @default(now())

  @@index([lessonId])
}
