generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum LessonOrigin {
  AI
  MANUAL
}

enum LessonStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

enum PlatformPreviewMode {
  TIKTOK
  YOUTUBE_SHORTS
  FACEBOOK_REELS
}

enum VideoProfile {
  SHORT_VERTICAL
}

enum MediaAssetKind {
  VOICEOVER
  MUSIC
  RENDER
}

enum RenderQualityPreset {
  DRAFT
  FINAL
}

enum JobStatus {
  QUEUED
  WAITING_FOR_CLI
  RUNNING
  COMPLETED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
}

enum JobCreatedBy {
  LOCAL_USER
}

model Book {
  id              String    @id @default(cuid())
  title           String
  author          String?
  description     String?
  language        String    @default("vi")
  slug            String?   @unique
  sourceFilePath  String
  sourceFileName  String
  sourceHash      String
  // "md" | "txt" — validated by features/books/domain (String keeps room for new formats without a migration).
  sourceFormat    String
  sourceSizeBytes Int
  // "ACTIVE" | "DELETED" (soft delete, alongside deletedAt).
  status          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  chapters          Chapter[]
  lessons           Lesson[]
  videos            Video[]
  extractions       BookExtraction[]
  productionBatches ProductionBatch[]

  @@index([status])
  @@index([createdAt])
  @@index([sourceHash])
}

model Chapter {
  id                    String    @id @default(cuid())
  bookId                String
  book                  Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order                 Int
  title                 String
  // Prefer file storage (data/books/{bookId}/chapters/{chapterId}.md); `content` is the inline fallback.
  contentPath           String?
  content               String?
  sourceStartOffset     Int?
  sourceEndOffset       Int?
  contentHash           String
  // CHAPTER_ANALYSIS_STATUSES in features/chapters/domain/analysis-status.ts.
  analysisStatus        String
  analyzedAt            DateTime?
  analysisPromptVersion String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  lessonSources LessonSource[]

  @@unique([bookId, order])
  @@index([bookId])
}

model Lesson {
  id                    String       @id @default(cuid())
  bookId                String
  book                  Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title                 String
  summary               String
  principle             String
  realLifeScenario      String
  commonMistake         String
  betterApproach        String
  actionableStep        String
  origin                LessonOrigin
  status                LessonStatus @default(DRAFT)
  contentHash           String?
  analysisPromptVersion String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  sources         LessonSource[]
  videoLessons    VideoLesson[]
  productionItems ProductionItem[]

  @@index([bookId])
  @@index([status])
}

model LessonSource {
  id            String  @id @default(cuid())
  lessonId      String
  lesson        Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  chapterId     String
  chapter       Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sourceExcerpt String?
  sourceLocator String?
  confidence    Float?

  // SQLite treats NULL locators as distinct, so uniqueness applies only when a locator is present.
  @@unique([lessonId, chapterId, sourceLocator])
  @@index([lessonId])
  @@index([chapterId])
}

model Video {
  id                     String               @id @default(cuid())
  bookId                 String
  book                   Book                 @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title                  String
  description            String?
  // VIDEO_STATUSES in features/videos/domain/video-status.ts (DRAFT | NEEDS_REVIEW | APPROVED).
  status                 String               @default("DRAFT")
  aspectRatio            String               @default("9:16")
  fps                    Int                  @default(30)
  width                  Int                  @default(1080)
  height                 Int                  @default(1920)
  videoProfile           VideoProfile         @default(SHORT_VERTICAL)
  // Allowed values {30, 45, 60, 90} are enforced by Zod, not by the database.
  targetDurationSec      Int                  @default(60)
  scriptVersion          Int                  @default(1)
  approvedScriptVersion  Int?
  // The scriptVersion at which the automated checks last passed. It is not an approval by a person: it only lets a FINAL
  // render proceed, and any later change bumps scriptVersion so it stops matching.
  autoReadyScriptVersion Int?
  platformPreviewMode    PlatformPreviewMode?
  // 2–3 AI hook proposals ({ variant, narration, onScreenText, visualVariant }[]); the chosen one becomes the HOOK scene.
  hookOptionsJson        Json?
  // Loose pointer to RenderRecord.id (no relation) to avoid a circular reference.
  latestRenderId         String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  videoLessons   VideoLesson[]
  scenes         VideoScene[]
  renders        RenderRecord[]
  mediaAssets    MediaAsset[]
  productionItem ProductionItem?

  @@index([bookId])
  @@index([status])
  @@index([createdAt])
}

model VideoLesson {
  id                 String   @id @default(cuid())
  videoId            String
  video              Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  lessonId           String
  lesson             Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  position           Int
  lessonSnapshotJson Json
  createdAt          DateTime @default(now())

  @@unique([videoId, lessonId])
  @@unique([videoId, position])
  @@index([lessonId])
}

model VideoScene {
  id               String   @id @default(cuid())
  videoId          String
  video            Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  order            Int
  // SCENE_TYPES / VISUAL_VARIANTS / HOOK_VARIANTS in features/videos/domain/scene-types.ts.
  type             String
  title            String?
  narration        String
  onScreenText     String
  visualVariant    String
  durationFrames   Int?
  estimatedSeconds Float?
  // Only meaningful when type = HOOK.
  hookVariant      String?
  // Loose pointer to MediaAsset.id (no relation), mirroring Video.latestRenderId.
  audioAssetId     String?
  contentHash      String
  version          Int      @default(1)
  // Hidden scenes stay in the script but are skipped in preview and render.
  hidden           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  mediaAssets MediaAsset[]

  @@unique([videoId, order])
  @@index([videoId])
}

model MediaAsset {
  id                     String         @id @default(cuid())
  videoId                String?
  video                  Video?         @relation(fields: [videoId], references: [id], onDelete: Cascade)
  sceneId                String?
  scene                  VideoScene?    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  kind                   MediaAssetKind
  // Relative to DATA_DIR.
  path                   String
  mimeType               String
  durationMs             Int?
  fileSizeBytes          Int
  contentHash            String?
  provider               String?
  generationSettingsJson Json?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([videoId])
  @@index([sceneId])
  @@index([kind])
}

model RenderRecord {
  id            String              @id @default(cuid())
  videoId       String
  video         Video               @relation(fields: [videoId], references: [id], onDelete: Cascade)
  // Loose pointer to JobRecord.id (no relation).
  jobRecordId   String?
  scriptVersion Int
  // Relative to DATA_DIR.
  outputPath    String
  // QUEUED | RENDERING | COMPLETED | FAILED | CANCELLED. "Outdated" is derived (scriptVersion < Video.scriptVersion), not stored.
  status        String
  durationMs    Int?
  qualityPreset RenderQualityPreset
  width         Int
  height        Int
  fps           Int
  createdAt     DateTime            @default(now())
  completedAt   DateTime?
  errorMessage  String?
  // What this render was made from, captured when it was requested and never changed afterwards (a RenderSnapshot).
  snapshotJson  Json?
  snapshotHash  String?

  @@index([videoId])
  @@index([status])
  @@index([createdAt])
}

model JobRecord {
  id                 String       @id @default(cuid())
  bullmqJobId        String       @unique
  jobType            String
  // SYSTEM (diagnostics) | CHAPTER | VIDEO | SCENE | RENDER.
  entityType         String
  entityId           String
  status             JobStatus    @default(QUEUED)
  progress           Int          @default(0)
  attempts           Int          @default(0)
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime     @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  updatedAt          DateTime     @updatedAt
  requestFingerprint String?
  createdBy          JobCreatedBy @default(LOCAL_USER)
  dispatch           JobDispatch?

  @@index([status])
  @@index([createdAt])
  @@index([entityType, entityId])
}

// Outbox row created in the same transaction as its JobRecord. dispatchedAt stays null until the BullMQ job exists,
// so a crash between the SQLite write and the Redis add cannot lose the job; availableAt holds delayed jobs back.
model JobDispatch {
  id           String    @id @default(cuid())
  jobRecordId  String    @unique
  jobRecord    JobRecord @relation(fields: [jobRecordId], references: [id], onDelete: Cascade)
  // IDs and small metadata only, without jobRecordId (added when the job is dispatched).
  payloadJson  String
  availableAt  DateTime  @default(now())
  attempts     Int       @default(0)
  lastError    String?
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?

  @@index([dispatchedAt, availableAt])
}

model AiRun {
  id            String    @id @default(cuid())
  // Loose pointer to JobRecord.id (no relation).
  jobRecordId   String?
  // "mock" | "cli-task" | later "automated-cli"; never store secrets or session tokens in this table.
  mode          String
  promptVersion String
  inputHash     String
  outputPath    String?
  status        String
  errorMessage  String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([jobRecordId])
  @@index([status])
}

// One pass that turns a PDF book into per-page text: the local text layer first, OCR only for pages without usable text.
// The PDF stays immutable; everything here is derived and can be rebuilt from it.
model BookExtraction {
  id                   String    @id @default(cuid())
  bookId               String
  book                 Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  // QUEUED | INSPECTING | EXTRACTING | OCR_PENDING | ASSEMBLING | COMPLETED | PARTIAL | FAILED | CANCELLED
  status               String
  // SHA-256 of the PDF this run read, so the run is tied to exact bytes.
  sourceHash           String
  // Known once the PDF has been inspected.
  pageCount            Int?
  // OCR provider and pinned model chosen for this run; null while no page needs OCR.
  ocrProvider          String?
  ocrModel             String?
  // Money is kept in integer micro-USD so ceiling checks never suffer floating-point drift.
  costCeilingMicroUsd  Int?
  // Amount reserved for OCR that is submitted or whose outcome is unknown.
  reservedCostMicroUsd Int       @default(0)
  actualCostMicroUsd   Int       @default(0)
  // Relative path (under DATA_DIR) of the assembled canonical Markdown.
  canonicalPath        String?
  errorCode            String?
  errorMessage         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  completedAt          DateTime?

  pages         ExtractionPage[]
  ocrOperations OcrOperation[]

  @@index([bookId])
  @@index([status])
}

// Result for one page of the source PDF. A blank page is a valid EXTRACTED result (method EMPTY), distinct from FAILED.
model ExtractionPage {
  id           String         @id @default(cuid())
  extractionId String
  extraction   BookExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  // 1-based page number in the source PDF; never an offset into normalized text.
  pageNumber   Int
  // PENDING | EXTRACTED | NEEDS_OCR | OCR_SUBMITTED | FAILED
  status       String
  // Set once the page is classified: TEXT | OCR | EMPTY.
  method       String?
  // Why the text layer was not usable, for pages that go to OCR.
  ocrReason    String?
  text         String?
  // OCR confidence 0..1 exactly as the provider reported it; null when none was reported (never invented).
  confidence   Float?
  errorCode    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([extractionId, pageNumber])
  @@index([extractionId, status])
}

// A batch handed to a remote OCR provider. The row exists before the submit call so an unknown outcome can be reconciled.
model OcrOperation {
  id                   String         @id @default(cuid())
  extractionId         String
  extraction           BookExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  provider             String
  model                String
  // Stable idempotency key the adapter uses to recognise a submission it already made.
  requestKey           String         @unique
  // PLANNED | SUBMITTING | SUBMITTED | COMPLETED | FAILED | CANCELLED | UNKNOWN_OUTCOME
  status               String
  // Opaque provider handle (OcrProvider operationRef); services never parse it.
  operationRef         String?
  pageCount            Int
  reservedCostMicroUsd Int
  // Only set when the provider reports a real figure.
  actualCostMicroUsd   Int?
  errorCode            String?
  errorMessage         String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  submittedAt          DateTime?
  lastPolledAt         DateTime?
  completedAt          DateTime?
  // Output saved locally; provider-side cleanup may only happen after this is set.
  outputStoredAt       DateTime?
  cleanedAt            DateTime?

  @@index([extractionId])
  @@index([status])
}

// A request to produce videos from lessons the user selected in one book. One item is one lesson and one video.
model ProductionBatch {
  id                String    @id @default(cuid())
  bookId            String
  book              Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  // Supplied by the caller; a repeated request with the same key returns this batch instead of making another.
  idempotencyKey    String    @unique
  // Hash of what was asked for (book, lessons, preset), to notice the same key being reused for different content.
  fingerprint       String
  targetDurationSec Int
  // QUEUED | RUNNING | COMPLETED | PARTIAL | FAILED | CANCELLED (a read model derived from the items).
  status            String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?

  items ProductionItem[]

  @@index([bookId])
  @@index([status])
}

model ProductionItem {
  id                     String          @id @default(cuid())
  batchId                String
  batch                  ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  // Restrict: a lesson cannot be hard-deleted while a production still points at it.
  lessonId               String
  lesson                 Lesson          @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  position               Int
  // The video made for this item; set when the item is created, so a retry reuses it instead of creating another.
  videoId                String?         @unique
  video                  Video?          @relation(fields: [videoId], references: [id], onDelete: SetNull)
  // PENDING | RUNNING | WAITING | COMPLETED | FAILED | CANCELLED
  status                 String
  // The last step finished, so a restart skips what is done: NONE | DRAFTED | COMPILED | APPLIED | VOICED | READY | RENDERED
  checkpoint             String          @default("NONE")
  // Fingerprint of the scene plan whose scenes are currently on the video, so applying the same plan again changes nothing.
  appliedPlanFingerprint String?
  // The single AI correction a video gets: where it went (SCRIPT_STUDIO | SCENE_COMPILER) and what it was told. Null while unused.
  aiCorrectionTarget     String?
  aiCorrectionNote       String?
  // Lease so that only one worker advances an item at a time; an expired lease can be taken over.
  claimToken             String?
  claimExpiresAt         DateTime?
  errorCode              String?
  errorMessage           String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  completedAt            DateTime?

  @@unique([batchId, lessonId])
  @@unique([batchId, position])
  @@index([status])
}
