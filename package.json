{
  "name": "book-video-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first studio that turns book lessons into short-form vertical (9:16) Vietnamese videos.",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9.7"
  },
  "scripts": {
    "preinstall": "node -e \"if(!/pnpm/.test(process.env.npm_config_user_agent||'')){console.error('This repository uses pnpm only. Run: pnpm install');process.exit(1)}\"",
    "postinstall": "prisma generate",
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "worker:dev": "tsx watch src/worker/main.ts",
    "worker:start": "tsx src/worker/main.ts",
    "ai:run": "tsx scripts/run-claude-task.ts",
    "diagnose": "tsx scripts/diagnose.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "remotion:studio": "remotion studio src/remotion/index.ts",
    "test:e2e": "pnpm build && playwright test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "better-sqlite3",
      "esbuild",
      "prisma"
    ]
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@remotion/bundler": "4.0.539",
    "@remotion/fonts": "4.0.539",
    "@remotion/player": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "bullmq": "6.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.0",
    "dotenv": "18.0.9",
    "ioredis": "6.0.0",
    "lucide-react": "1.62.0",
    "mdast-util-to-string": "4.0.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-parse": "11.0.0",
    "remotion": "4.0.539",
    "server-only": "0.0.1",
    "shadcn": "4.22.2",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@remotion/cli": "4.0.539",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdast": "4.0.4",
    "@types/node": "24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
