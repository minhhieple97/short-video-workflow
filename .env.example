NODE_ENV=development
DATABASE_URL=file:./data/studio.db
DATA_DIR=./data
REDIS_URL=redis://127.0.0.1:6379

# Book import: max upload size and optional extra chapter heading regexes (JSON array, case-insensitive)
MAX_IMPORT_SIZE_MB=10
CHAPTER_HEADING_PATTERNS=[]

# PDF books (streamed to disk, never held in memory): max upload size in MB
MAX_PDF_SIZE_MB=500

# OCR spend ceiling per book in USD, copied onto each extraction when it is created (never raised automatically)
OCR_COST_CEILING_USD=3
# PDF books are read with Poppler (sudo apt-get install -y poppler-utils). Leave POPPLER_BIN_DIR empty to use PATH.
MAX_PDF_PAGES=1000
POPPLER_BIN_DIR=
PDF_TOOL_TIMEOUT_SEC=300

# Mistral OCR Batch (the only OCR provider). Leave the key empty until you run OCR; it is read only by the worker.
# The model is pinned (no "latest" alias): check it exists for your account before the first real run.
# USD_PER_1000_PAGES is the batch price used for the budget estimate; confirm it on Mistral's pricing page.
MISTRAL_API_KEY=
MISTRAL_API_BASE_URL=https://api.mistral.ai
MISTRAL_OCR_MODEL=mistral-ocr-4-1
MISTRAL_OCR_USD_PER_1000_PAGES=2

# NotebookLM (script studio), reached through notebooklm-mcp-cli started by the worker with uvx. Sign in once in your own
# terminal with `nlm login --profile <name>` (uvx --from notebooklm-mcp-cli nlm login --profile <name>) and put that name
# here; the worker uses it for its own process only and never changes your default profile. The package is pinned on
# purpose: it uses NotebookLM's undocumented API.
NOTEBOOKLM_PROFILE=
NOTEBOOKLM_MCP_COMMAND=uvx
NOTEBOOKLM_MCP_PACKAGE=notebooklm-mcp-cli==0.15.8
NOTEBOOKLM_CALL_TIMEOUT_SEC=180

# Google Drive archive (optional). Create an OAuth client of type "Desktop app" in your own Google Cloud project, with the
# Google Drive API enabled; the app asks only for the drive.file scope. Desktop clients are public, so this secret is
# not really secret, but it is still never logged. Leave both empty to keep videos local only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The app's own Drive limits (not Google's project quota, and unrelated to your storage plan): at most one request per
# interval, and per rolling 24 hours this many requests and this much uploaded data.
DRIVE_MIN_REQUEST_INTERVAL_MS=1000
DRIVE_MAX_REQUESTS_PER_DAY=5000
DRIVE_MAX_UPLOAD_GIB_PER_DAY=10

# AI: mock | cli-task | cli-auto
#   mock     = sample data, no Claude
#   cli-task = jobs wait until you run `pnpm ai:run --job <id>` (default)
#   cli-auto = the worker runs your own logged-in Claude Code CLI automatically (opt-in, personal use only)
AI_MODE=cli-task
MAX_AI_CONCURRENCY=1
CLAUDE_CLI_COMMAND=claude
# Max seconds one Claude Code call may take
AI_TASK_TIMEOUT_SEC=600

# Audio: upload | edge-tts
TTS_MODE=edge-tts
TTS_VOICE=vi-VN-NamMinhNeural
# Speed in percent, -50..50 (0 = natural)
TTS_SPEED=0
# Use the latest edge-tts (pip install -U edge-tts); an absolute path also works
EDGE_TTS_COMMAND=edge-tts
# Pause added after each narration clip, and the upload size limit
SCENE_AUDIO_PADDING_MS=300
MAX_AUDIO_UPLOAD_MB=20

# Short-form output: 9:16 portrait (TikTok / YouTube Shorts / Facebook Reels)
VIDEO_PROFILE=SHORT_VERTICAL
DEFAULT_VIDEO_DURATION_SEC=60
MAX_VIDEO_DURATION_SEC=90
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_FPS=30
RENDER_CONCURRENCY=1
WORKER_CONCURRENCY=1
DRAFT_RENDER_WIDTH=720
DRAFT_RENDER_HEIGHT=1280
